{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Starsector DevTool",
  "version": "0.1.0",
  "identifier": "com.starsector.devtool",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Starsector DevTool",
        "width": 1360,
        "height": 860,
        "minWidth": 1100,
        "minHeight": 720,
        "decorations": false
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/icon.ico"]
  }
}
